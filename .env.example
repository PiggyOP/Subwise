# Local development defaults. Copy this file to .env.
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=data/subwise.sqlite
# Hosted PostgreSQL only. Keep the pooled TLS connection URI secret.
DATABASE_URL=
NODE_ENV=development
TRUST_PROXY=0
# Production: HTTPS origin, NODE_ENV=production; PostgreSQL or encrypted persistent disk.
# Set TRUST_PROXY=1 only behind exactly one trusted reverse proxy.

# AI is disabled until configured. Keep secrets server-side.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# India membership billing. Use test credentials first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=
# Enforces Plus access even before checkout is configured.
REQUIRE_PAID_PLAN=true

# Temporary local testing entitlement. Production refuses to boot if true.
ENABLE_TEST_PLUS=false
# A contracted server-side adapter implements docs/CONNECTIONS.md.
FINANCIAL_CONNECTOR_URL=
FINANCIAL_CONNECTOR_SECRET=
FINANCIAL_WEBHOOK_SECRET=
FINANCIAL_CONNECTOR_CHANNELS=
FINANCIAL_AUTH_ORIGINS=

# Customer email delivery (Resend). No emails are sent without this configuration.
RESEND_API_KEY=
EMAIL_FROM=
# Generate a long random secret; rotating it invalidates existing unsubscribe links.
EMAIL_UNSUBSCRIBE_SECRET=

# Separate, merchant-authorized cancellation adapter. Leave blank until contracted.
# This is not a bank-data API and must not be pointed directly at an unrelated provider.
CANCELLATION_CONNECTOR_URL=
CANCELLATION_CONNECTOR_SECRET=
CANCELLATION_WEBHOOK_SECRET=

# Operator-only test-account provisioning. Never commit actual values.
# The password value must be a salted scrypt hash, never plaintext.
PLUS_TEST_EMAIL=
PLUS_TEST_PASSWORD_HASH=
# Setu AA sandbox (server-only; never prefix these with VITE_).
# Restricted to explicitly listed test accounts. No live-bank/card/mandate access.
SETU_SANDBOX_ENABLED=false
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_ID=
SETU_SANDBOX_EMAILS=
# Generate at least 32 random characters. Bridge callback:
# https://your-subwise-host/api/webhooks/setu/<SETU_WEBHOOK_TOKEN>
SETU_WEBHOOK_TOKEN=

# Subwise-owned synthetic demo bank. No external calls, SMS or real financial data.
# This does not grant Plus; only explicitly allowlisted signed-in Plus accounts can use it.
DEMO_BANK_ENABLED=false
DEMO_BANK_EMAILS=

# Hosted maintenance: Vercel executes jobs, the existing Netlify scheduler triggers them.
# Keep the same random secret on both hosts; never use a VITE_ prefix.
SUBWISE_WORKER_SECRET=
# Netlify only. Unset to retain the original local worker execution.
SUBWISE_WORKER_ORIGIN=
# Vercel production must set NODEJS_HELPERS=0 and SUBWISE_SERVERLESS=1.

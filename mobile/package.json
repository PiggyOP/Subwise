{
  "name": "subwise-mobile",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "check": "expo install --check",
    "bundle": "expo export --platform all --output-dir build",
    "start:go": "expo start --go",
    "config": "expo config --type public",
    "test:config": "node --test tests/config.test.cjs",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:ios:simulator": "npx eas-cli build --platform ios --profile preview-simulator",
    "build:production": "npx eas-cli build --platform all --profile production"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "expo": "^58.0.17",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "^58.0.14",
    "expo-secure-store": "^58.0.2",
    "expo-status-bar": "^58.0.4",
    "expo-system-ui": "~58.0.6",
    "react": "19.3.0",
    "react-native": "^0.88.0",
    "react-native-safe-area-context": "^5.10.1"
  },
  "private": true

# Public configuration only: this value is embedded in the installed app.
# Replace the placeholder with the real HTTPS origin, without /api or a trailing path.
# A phone cannot reach the computer's backend through localhost.
EXPO_PUBLIC_API_URL=https://YOUR_BACKEND_DOMAIN

# Optional. Supplied automatically by the matching eas.json profile on cloud builds.
SUBWISE_APP_VARIANT=development

# Optional. Set to the actual project UUID after linking the project with EAS.
# Do not invent an ID. It is public project metadata, not an API secret.
EAS_PROJECT_ID=
